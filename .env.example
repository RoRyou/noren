# .env にコピーして記入してください。.env は .gitignore 済みのため、コミットされません。
# Cloud Run では環境変数とサービスアカウントを使い、このファイルは読みません。

# TRUE = Gemini Enterprise Agent Platform（Vertex AI。GCP の請求先に課金）
# FALSE = AI Studio の API キー（予備）
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# FALSE のときだけ使用
GOOGLE_API_KEY=

# GCP プロジェクト（Firestore / Cloud Run / Logging）
GOOGLE_CLOUD_PROJECT=noren-vol5
GOOGLE_CLOUD_LOCATION=asia-northeast1
# ローカル用：ADC の認証情報ファイルのパス（空なら gcloud 既定の ADC を使用）
GOOGLE_APPLICATION_CREDENTIALS=

# リアルタイム音声モデル（Agent Platform の 3.8 Live は us / eu リージョンのみ）
LIVE_MODEL=gemini-3.8-live
LIVE_LOCATION=us-central1

# Firestore（ローカルはエミュレーター：FIRESTORE_EMULATOR_HOST=127.0.0.1:8681、FIRESTORE_PROJECT=demo-noren）
FIRESTORE_PROJECT=
# デモ店の cookie の署名鍵（空なら起動ごとに生成）。デモ店の時刻（空なら実時刻）
DEMO_SECRET=
DEMO_CLOCK=19:00
# 時間指定の処理（Cloud Tasks）。空ならプロセス内のタイマー（ローカル）
TASKS_QUEUE=
TASKS_LOCATION=asia-northeast1
TASKS_SERVICE_ACCOUNT=
PUBLIC_BASE_URL=
# 遅延の調整（空ならモデルの既定）
LIVE_THINKING_BUDGET=
LIVE_SILENCE_MS=

# 复制为 .env 后填写。.env 已在 .gitignore 中，不要提交。
# 部署到 Cloud Run 时改用 Secret Manager，不读这个文件。

# Gemini API（AI Studio 发的 API 密钥；要在绑定了优惠券账单的 GCP 项目下创建）
GOOGLE_API_KEY=
# ADK 约定：TRUE = 走 Agent Platform（Vertex，费用记到 GCP 账单）；FALSE = 用 AI Studio 的 API 密钥
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# GCP 项目（Firestore / Cloud Run / Logging 用）
GOOGLE_CLOUD_PROJECT=noren-vol5
GOOGLE_CLOUD_LOCATION=asia-northeast1
# 本地用：个人账号的 ADC（用 CLOUDSDK_CONFIG=~/.config/gcloud-noren 单独登录，不覆盖其他 gcloud 登录）
GOOGLE_APPLICATION_CREDENTIALS=

# 实时语音模型
LIVE_MODEL=gemini-3.8-live
# Agent Platform 上的 3.8 Live 只有 us / eu 区域
LIVE_LOCATION=us-central1
